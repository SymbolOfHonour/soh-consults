{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "soh-consults-qa",
  "main": "cloudflare-qa-worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "triggers": {
    "crons": ["0 5 * * *", "0 6 * * *", "0 7 * * *"]
  },
  "vars": {
    "SUPABASE_URL": "https://hyzyklmctuppypvqxggo.supabase.co",
    "NEWS_IMPORT_REQUEST_BUDGET": "32"
  }
}
